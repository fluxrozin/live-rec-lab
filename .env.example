# LiveRecorder（WSL2）の環境変数設定例
# このファイルを .env にコピーし、利用するサービスの認証情報だけを入力してください。
# .env はコミットせず、トークンはログ・Issue・チャットに貼り付けないでください。

# ツイキャス API（利用する場合に設定）
TWITCASTING_CLIENT_ID=
TWITCASTING_CLIENT_SECRET=

# Euler Stream 署名 API（任意。第1フェーズで実際の利用条件を確認）
SIGN_API_KEY=

# インスタンスごとの保存先を分ける場合に設定
# LIVE_REC_LAB_DATA_DIR=/home/your-user/.local/share/live-rec-lab/data
# LIVE_REC_LAB_STATE_DIR=/home/your-user/.local/state/live-rec-lab
# LIVE_REC_LAB_RECORDING_ROOT=/mnt/d/live-rec-lab/recordings

# 録画前に設定してください。既存の LiveRecorder や他の試作環境で
# 実際に使われている録画先を確認し、WSL の絶対パスで指定します。
# 複数ある場合はセミコロンで区切ります。他に使用中の録画先がないと
# 確認できた場合のみ none を指定してください。未設定の場合は録画が無効になります。
# LIVE_REC_LAB_EXISTING_RECORDING_ROOTS='/mnt/d/other-app/recordings;/mnt/e/other-trial/recordings'

# Linux 版の ffmpeg と ffprobe が両方入っているディレクトリ（任意）
# LIVE_REC_LAB_FFMPEG_BIN=/home/your-user/.local/opt/ffmpeg/bin
