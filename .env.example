# 通常運用の環境例。使用時は .env として配置し chmod 600。.env は Git に含めない。
# 秘密値はここに書かない（ダミーのみ）。
TWITCASTING_CLIENT_ID=
TWITCASTING_CLIENT_SECRET=
SIGN_API_KEY=
# LIVE_REC_LAB_DATA_DIR=~/.local/share/live-rec-lab/data
# LIVE_REC_LAB_STATE_DIR=~/.local/state/live-rec-lab
# LIVE_REC_LAB_RECORDING_ROOT=/mnt/d/LiveRecorder
# ffmpeg と ffprobe を置いたディレクトリ（非対話起動のPATHは対話シェルと異なるため固定を推奨）
# LIVE_REC_LAB_FFMPEG_BIN=/home/USER/.local/opt/ffmpeg-9.1/bin
# 0=通常 / 1=監視・新規ジョブ起動を停止
# LIVE_REC_LAB_DISABLE_SCHEDULER=0
