# LiveRecorder (WSL2) — environment-variable template
# Copy to .env and fill in only the credentials for services you use.
# Never commit .env or paste tokens into logs, issues, or chat.

# TwitCasting API (optional until configured)
TWITCASTING_CLIENT_ID=
TWITCASTING_CLIENT_SECRET=

# Euler Stream signing API (optional; validate actual contract in Phase 1)
SIGN_API_KEY=

# Optional per-instance isolation (set only when needed)
# LIVE_REC_LAB_DATA_DIR=/home/your-user/.local/share/live-rec-lab/data
# LIVE_REC_LAB_STATE_DIR=/home/your-user/.local/state/live-rec-lab
# LIVE_REC_LAB_RECORDING_ROOT=/mnt/d/live-rec-lab/recordings
