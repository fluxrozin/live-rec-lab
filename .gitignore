# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Local test / lint / coverage artifacts
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
playwright-report/
test-results/

# Virtual environments
.venv/

# Secrets and local-only environment
.env
.env.*
!.env.example
*.pem
*.key

# Local runtime artifacts (not implementation documentation)
*.sqlite
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.db
*.db-wal
*.db-shm
/logs/
/recordings/
/runtime/
# Runtime directories at custom locations must be outside the repository or explicitly ignored.

# Developer-mode local diagnostics / artifacts (never commit)
.dev-runtime/
.diagnostics/

# UI evidence: shareable reviewed assets remain tracked; raw/local evidence never tracked
/specs/*/ui/local-artifacts/

/ui/local-artifacts/

# Local media/model caches and raw validation assets (custom locations must also be protected)
/models/
/media/
/local-artifacts/
/backups/
/test-artifacts/
/.cache/
*.sqlite-wal
*.sqlite-shm

# Node tooling for Markdown format / lint
node_modules/
